{
	"schemaVersion": 1,
	"id": "preciseglower",
	"version": "${version}",
	"name": "Precise Glower",
	"description": "Highlights blocks, entities and dropped items with per-rule colors, plus block-state and NBT filters.",
	"authors": ["preciseglower contributors"],
	"contact": {
		"sources": "https://github.com/wlm3201/precise-glower"
	},
	"license": "MIT",
	"icon": "assets/preciseglower/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.preciseglower.client.PreciseGlowerClient"]
	},
	"mixins": [
		{
			"config": "preciseglower.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"java": ">=25",
		"minecraft": "${minecraft_dependency}",
		"fabric-api": "*"
	}
}
